{
  "schema_version": 1,
  "project_name": "CRM",
  "primary_branch": "master",
  "license": "MIT",
  "state_file": "feature_list.json",
  "progress_directory": "progress",
  "test_command": "UV_CACHE_DIR=/tmp/uv-cache ../scripts/verify-fast.sh",
  "agent_policy": {
    "supported_models": {
      "gpt-5.6-sol": {
        "reasoning_efforts": ["none", "low", "medium", "high", "xhigh", "max"]
      },
      "gpt-5.6-terra": {
        "reasoning_efforts": ["none", "low", "medium", "high", "xhigh", "max"]
      },
      "gpt-5.6-luna": {
        "reasoning_efforts": ["none", "low", "medium", "high", "xhigh", "max"]
      }
    },
    "role_defaults": {
      "orchestrator": {
        "model": "gpt-5.6-sol",
        "reasoning_effort": "high"
      },
      "implementer": {
        "model": "gpt-5.6-terra",
        "reasoning_effort": "high"
      },
      "validator": {
        "model": "gpt-5.6-sol",
        "reasoning_effort": "high"
      },
      "explorer": {
        "model": "gpt-5.6-luna",
        "reasoning_effort": "medium"
      }
    }
  },
  "verification": {
    "required_before_done": true,
    "allow_documented_manual_verification": true
  }
}
