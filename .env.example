# Development-only example. Copy to .env only if your shell tooling loads it.
DJANGO_SETTINGS_MODULE=simple_crm.config.settings.development
# DATABASE_URL=postgresql://crm_user:replace-me@localhost:5432/simple_crm

# Staging and production require all three values. Never commit real values.
# DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
# DJANGO_ALLOWED_HOSTS=crm.example.com
# DATABASE_URL=postgresql://crm_user:replace-me@db.example.com:5432/crm
# DJANGO_DEBUG=false
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true

# Dedicated PostgreSQL 18 migration acceptance only; never use an application DB.
# SIMPLE_CRM_POSTGRES_ACCEPTANCE=1
# DATABASE_URL=postgresql://crm_user:replace-me@localhost:5432/simple_crm_crm003_test

# Dedicated PostgreSQL 18 catalog acceptance only; it must be empty.
# SIMPLE_CRM_POSTGRES_ACCEPTANCE=1
# DATABASE_URL=postgresql://crm_user:replace-me@localhost:5432/simple_crm_crm004_test
